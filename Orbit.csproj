<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Orbit File Manager</Product>
  </PropertyGroup>

  <!-- the installer and release output are separate projects / folders -->
  <ItemGroup>
    <Compile Remove="installer\**;dist\**" />
    <None Remove="installer\**;dist\**" />
    <EmbeddedResource Remove="installer\**;dist\**" />
    <Page Remove="installer\**;dist\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.12" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Material Icon Theme (MIT) — https://github.com/material-extensions/vscode-material-icon-theme, via @iconify-json/material-icon-theme 1.2.77 -->
    <Resource Include="Assets\orbit.ico" />
    <EmbeddedResource Include="Assets\material-icons.json" LogicalName="Orbit.material-icons.json" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- Icon packs: separate data files under their own licences (see Assets\icons\README.txt) -->
    <None Include="Assets\icons\**\*" Link="icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
