<Window x:Class="Orbit.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to server" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>



    <Style x:Key="PwBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
    </Style>

  </Window.Resources>

  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <StackPanel Margin="22,0,22,20">
      <DockPanel Height="44">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="Cancel_Click"
                WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,-12,0"/>
        <TextBlock x:Name="TitleText" Text="Connect to server" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" Margin="0,2,0,4"/>

      <StackPanel x:Name="FullForm">
        <Border Background="{DynamicResource PanelBg}" CornerRadius="9" Padding="2" HorizontalAlignment="Left" Margin="0,4,0,2">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RbSmb" Style="{StaticResource Seg}" Content="SMB / Samba" GroupName="proto" IsChecked="True" Checked="Proto_Changed"/>
            <RadioButton x:Name="RbSftp" Style="{StaticResource Seg}" Content="SFTP (SSH)" GroupName="proto" Checked="Proto_Changed"/>
            <RadioButton x:Name="RbDav" Style="{StaticResource Seg}" Content="WebDAV" GroupName="proto" Checked="Proto_Changed"/>
            <RadioButton x:Name="RbGdrive" Style="{StaticResource Seg}" Content="Google Drive" GroupName="proto" Checked="Proto_Changed"/>
            <RadioButton x:Name="RbDropbox" Style="{StaticResource Seg}" Content="Dropbox" GroupName="proto" Checked="Proto_Changed"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ProtoHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,8,0,0"/>

        <StackPanel x:Name="ServerFields">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="90"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="Server (host name or IP)"/>
            <TextBox x:Name="HostBox" Style="{StaticResource Field}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource Label}" Text="Port"/>
            <TextBox x:Name="PortBox" Style="{StaticResource Field}"/>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="PathLabel" Style="{StaticResource Label}" Text="Share and folder"/>
        <TextBox x:Name="PathBox" Style="{StaticResource Field}"/>

        <TextBlock Style="{StaticResource Label}" Text="Username (optional)"/>
        <TextBox x:Name="UserBox" Style="{StaticResource Field}"/>

        <StackPanel x:Name="KeyPanel">
          <TextBlock Style="{StaticResource Label}" Text="Private key file (optional — ~/.ssh keys are tried automatically)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgButton}" Content="Browse…" Margin="8,0,0,0" MinWidth="0" Click="BrowseKey_Click"/>
            <TextBox x:Name="KeyBox" Style="{StaticResource Field}"/>
          </DockPanel>
        </StackPanel>

        <CheckBox x:Name="HttpsCheck" Style="{StaticResource Check}" Content="Use HTTPS" IsChecked="True" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- Google Drive / Dropbox -->
        <StackPanel x:Name="CloudPanel" Visibility="Collapsed" Margin="0,12,0,0">
          <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="CloudDot" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CloudStatus" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="CloudDetail" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="CloudOpenBtn" Style="{StaticResource DlgButton}" Content="Open in Orbit" Margin="0,0,8,0" Click="CloudOpen_Click"/>
                <Button x:Name="CloudGetBtn" Style="{StaticResource DlgButton}" Content="Get the desktop app" Margin="0,0,8,0" Click="CloudGet_Click"/>
                <Button Style="{StaticResource DlgButton}" Content="Check again" Click="CloudRecheck_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Or mount it as a drive letter (advanced)" FontWeight="SemiBold"/>
              <TextBlock x:Name="RcloneStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
              <WrapPanel x:Name="RcloneGetPanel" Margin="0,12,0,0">
                <Button x:Name="RcloneGetBtn" Style="{StaticResource DlgButton}" Content="Get rclone" Margin="0,0,8,0" Click="RcloneGet_Click"/>
                <Button x:Name="WinFspGetBtn" Style="{StaticResource DlgButton}" Content="Get WinFsp" Click="WinFspGet_Click"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="PasswordPanel">
        <TextBlock x:Name="PwLabel" Style="{StaticResource Label}" Text="Password (not saved)"/>
        <PasswordBox x:Name="PwBox" Style="{StaticResource PwBox}"/>
      </StackPanel>

      <StackPanel x:Name="SavePanel">
        <TextBlock Style="{StaticResource Label}" Text="Name in sidebar (optional)"/>
        <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
        <CheckBox x:Name="SaveCheck" Style="{StaticResource Check}" Content="Save to the Network section" IsChecked="True" Margin="0,14,0,0"/>
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="#F38BA8" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Style="{StaticResource DlgButton}" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="OkBtn" Style="{StaticResource DlgButton}" Content="Connect" IsDefault="True" Margin="10,0,0,0"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource ContentBg}" BorderBrush="{DynamicResource AccentBrush}"
                FontWeight="SemiBold" Click="Ok_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
