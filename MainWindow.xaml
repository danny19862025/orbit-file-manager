<Window x:Class="Orbit.MainWindow"
        Icon="pack://application:,,,/Assets/orbit.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Orbit"
        Title="Orbit" Width="1240" Height="800" MinWidth="720" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SidebarBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- Sidebar entry -->
    <DataTemplate x:Key="SideTemplate" DataType="{x:Type local:SideItem}">
      <Button Style="{StaticResource SideButton}" Tag="{Binding}" Click="SideItem_Click" MouseUp="SideItem_MouseUp"
              MouseRightButtonUp="SideItem_RightClick" AllowDrop="True" DragOver="SideItem_DragOver" Drop="SideItem_Drop"
              ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="900">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"
                     Visibility="{Binding HasGlyph, Converter={StaticResource BoolVis}}"/>
          <Ellipse Width="10" Height="10" Fill="{Binding TagBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding IsTagItem, Converter={StaticResource BoolVis}}"/>
          <DockPanel Grid.Column="1" LastChildFill="False">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="7,1,0,0" VerticalAlignment="Center" ToolTip="Connected"
                     Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}"/>
          </DockPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                    Background="{DynamicResource HoverBg}" VerticalAlignment="Center"
                    Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding Badge}" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
          </StackPanel>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource UsageBar}" Value="{Binding Usage, Mode=OneWay}"
                       Margin="0,2,0,6" Visibility="{Binding ShowUsage, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Tab -->
    <DataTemplate x:Key="TabTemplate" DataType="{x:Type local:TabState}">
      <Border x:Name="TabRoot" Height="40" MinWidth="40" MaxWidth="220" Background="Transparent" Tag="{Binding}"
              WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900"
              MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp" MouseMove="Tab_MouseMove" AllowDrop="True"
              DragEnter="Tab_DragEnter" DragOver="Tab_DragOver" DragLeave="Tab_DragLeave" Drop="Tab_Drop">
        <Grid>
          <Grid Margin="12,0,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TabText" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
            <Button x:Name="TabClose" Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Margin="8,0,0,0"
                    Click="TabClose_Click" Tag="{Binding}" Visibility="Hidden"/>
          </Grid>
          <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                  CornerRadius="1" Margin="4,0" Visibility="Hidden"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextBrush}"/>
          <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
          <Setter TargetName="TabClose" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="TabClose" Property="Visibility" Value="Visible"/>
          <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource HoverBg}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Breadcrumb -->
    <DataTemplate x:Key="CrumbTemplate" DataType="{x:Type local:Crumb}">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Click="Crumb_Click" Tag="{Binding}"
                AllowDrop="True" DragOver="Crumb_DragOver" Drop="Crumb_Drop"/>
        <Button Style="{StaticResource CrumbChevron}" Content="&#xE76C;" Click="CrumbChevron_Click" Tag="{Binding}"
                ToolTip="Subfolders" Visibility="{Binding IsLast, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
      </StackPanel>
    </DataTemplate>

    <!-- Grid tile -->
    <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type local:FileItem}">
      <Grid x:Name="Root">
        <Grid.RowDefinitions>
          <RowDefinition Height="70"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Source="{Binding LargeIcon}" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding TagBrushes}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                      Focusable="False" IsHitTestVisible="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Ellipse Width="10" Height="10" Fill="{Binding}" Margin="-2,0,0,0" Stroke="{DynamicResource ContentBg}" StrokeThickness="1.5"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NameText" Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" MaxHeight="36" Margin="2,2,2,0" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
        <TextBox Grid.Row="1" Style="{StaticResource RenameBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}" TextWrapping="Wrap" TextAlignment="Center"
                 VerticalAlignment="Top" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"
                 IsVisibleChanged="RenameBox_IsVisibleChanged"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCut}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="GridItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="1000"/>
      <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
      <EventSetter Event="MouseUp" Handler="Item_MouseUp"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Details row cells -->
    <DataTemplate x:Key="NameCell" DataType="{x:Type local:FileItem}">
      <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="26"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="{Binding SmallIcon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left"/>
        <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Style="{StaticResource RenameBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}" KeyDown="RenameBox_KeyDown"
                 LostKeyboardFocus="RenameBox_LostFocus" IsVisibleChanged="RenameBox_IsVisibleChanged"/>
        <ItemsControl Grid.Column="2" ItemsSource="{Binding TagBrushes}" Margin="6,0,0,0" VerticalAlignment="Center"
                      Focusable="False" IsHitTestVisible="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Ellipse Width="9" Height="9" Fill="{Binding}" Margin="2,0,0,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCut}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="DateCell" DataType="{x:Type local:FileItem}">
      <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    <DataTemplate x:Key="TypeCell" DataType="{x:Type local:FileItem}">
      <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    <DataTemplate x:Key="SizeCell" DataType="{x:Type local:FileItem}">
      <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
    </DataTemplate>

    <Style x:Key="DetailsItemStyle" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="1200"/>
      <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
      <EventSetter Event="MouseUp" Handler="Item_MouseUp"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="0,4">
              <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dropzone entry -->
    <DataTemplate x:Key="DzTemplate" DataType="{x:Type local:FileItem}">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,3" Tag="{Binding}" ToolTip="{Binding FullPath}"
              PreviewMouseLeftButtonDown="Dz_MouseDown" PreviewMouseMove="Dz_MouseMove" MouseRightButtonUp="Dz_RightClick">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image Source="{Binding SmallIcon}" Width="16" Height="16" HorizontalAlignment="Left"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"/>
          <Button x:Name="X" Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;" Tag="{Binding}"
                  Click="DzRemove_Click" Visibility="Hidden" ToolTip="Remove from Dropzone"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
          <Setter TargetName="X" Property="Visibility" Value="Visible"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Tree View rows ===== -->
    <Style x:Key="TreeChevron" TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Content" Value="&#xE76C;"/>
    </Style>

    <DataTemplate x:Key="TreeRowTemplate" DataType="{x:Type local:FileItem}">
      <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="{Binding TreeIndent}"/>
          <Grid DockPanel.Dock="Left" Width="22">
            <Button x:Name="Chev" Style="{StaticResource TreeChevron}" Tag="{Binding}" Click="TreeChevron_Click"
                    Visibility="{Binding IsDir, Converter={StaticResource BoolVis}}"/>
          </Grid>
          <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TagBrushes}" Margin="6,0,8,0" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Ellipse Width="9" Height="9" Fill="{Binding}" Margin="2,0,0,0"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid>
            <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBox Style="{StaticResource RenameBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}" KeyDown="RenameBox_KeyDown"
                     LostKeyboardFocus="RenameBox_LostFocus" IsVisibleChanged="RenameBox_IsVisibleChanged"/>
          </Grid>
        </DockPanel>
        <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter TargetName="Chev" Property="Content" Value="&#xE70D;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCut}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="1200"/>
      <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
      <EventSetter Event="MouseUp" Handler="Item_MouseUp"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Miller Columns rows ===== -->
    <DataTemplate x:Key="ColumnRowTemplate" DataType="{x:Type local:FileItem}">
      <DockPanel x:Name="Root">
        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding IsDir, Converter={StaticResource BoolVis}}"/>
        <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Grid>
          <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBox Style="{StaticResource RenameBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                   Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}" KeyDown="RenameBox_KeyDown"
                   LostKeyboardFocus="RenameBox_LostFocus" IsVisibleChanged="RenameBox_IsVisibleChanged"/>
        </Grid>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="NameText" Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCut}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Split pane rows ===== -->
    <DataTemplate x:Key="SplitRowTemplate" DataType="{x:Type local:FileItem}">
      <DockPanel x:Name="Root">
        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0"/>
        <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHidden}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SplitItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="1200"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" BorderBrush="{DynamicResource RootBorder}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarCol" Width="250" MinWidth="180" MaxWidth="480"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================== SIDEBAR ===================== -->
      <Grid x:Name="Sidebar" Background="{DynamicResource SidebarBg}" AllowDrop="True"
            PreviewDragOver="Sidebar_PreviewDragOver" PreviewDragLeave="Sidebar_PreviewDragLeave" PreviewDrop="Sidebar_PreviewDrop">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="16,4,8,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE89F;" FontSize="14"
                  ToolTip="Hide sidebar" Click="ToggleSidebar_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14" Margin="0,0,2,0"
                  ToolTip="Settings (Ctrl+,)" Click="Settings_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- the app icon, drawn live so its moon can travel round the ring once when Orbit opens (MainWindow.Intro.cs) -->
            <Canvas x:Name="TitleIcon" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
            <TextBlock Text="Orbit" FontWeight="SemiBold" FontSize="15.5" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="8,0,8,8">
            <ToggleButton x:Name="TglPlaces" Style="{StaticResource SectionToggle}" Content="Places" Margin="0,2,0,2"/>
            <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"
                          Visibility="{Binding IsChecked, ElementName=TglPlaces, Converter={StaticResource BoolVis}}"/>
            <Border x:Name="PlacesDropHint" Visibility="Collapsed" AllowDrop="True" Margin="0,4,0,2" Padding="10,8" CornerRadius="8"
                    BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBg}"
                    DragOver="PlacesHint_DragOver" Drop="PlacesHint_Drop">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Drop here to add to Places" Foreground="{DynamicResource AccentBrush}" FontSize="12.5"/>
              </StackPanel>
            </Border>

            <StackPanel x:Name="SecBookmarks">
            <ToggleButton x:Name="TglBookmarks" Style="{StaticResource SectionToggle}" Content="Bookmarks"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=TglBookmarks, Converter={StaticResource BoolVis}}">
              <TextBlock Text="No bookmarks — press ☆ or Ctrl+D" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="10,4,0,4"
                         Visibility="{Binding Bookmarks.Count, Converter={StaticResource CountVis}, ConverterParameter=zero}"/>
              <ItemsControl ItemsSource="{Binding Bookmarks}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"/>
            </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SecTags">
            <ToggleButton x:Name="TglTags" Style="{StaticResource SectionToggle}" Content="Tags"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=TglTags, Converter={StaticResource BoolVis}}">
              <TextBlock Text="No tags — right-click a file › Tags" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="10,4,0,4"
                         Visibility="{Binding TagItems.Count, Converter={StaticResource CountVis}, ConverterParameter=zero}"/>
              <ItemsControl ItemsSource="{Binding TagItems}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"/>
            </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SecDrives">
            <ToggleButton x:Name="TglDrives" Style="{StaticResource SectionToggle}" Content="Drives"/>
            <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"
                          Visibility="{Binding IsChecked, ElementName=TglDrives, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            <StackPanel x:Name="SecNetwork">
            <StackPanel Visibility="{Binding Network.Count, Converter={StaticResource CountVis}}">
              <ToggleButton x:Name="TglNetwork" Style="{StaticResource SectionToggle}" Content="Network"/>
              <ItemsControl ItemsSource="{Binding Network}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"
                            Visibility="{Binding IsChecked, ElementName=TglNetwork, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SecRecent">
            <StackPanel Visibility="{Binding Recent.Count, Converter={StaticResource CountVis}}">
              <ToggleButton x:Name="TglRecent" Style="{StaticResource SectionToggle}" Content="Recent"/>
              <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource SideTemplate}" Focusable="False"
                            Visibility="{Binding IsChecked, ElementName=TglRecent, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Dropzone -->
        <Border x:Name="DropzoneBorder" Grid.Row="2" Margin="8,4,8,10" CornerRadius="10" Background="{DynamicResource DropzoneBg}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8,6,6,8"
                AllowDrop="True" DragOver="Dz_DragOver" DragLeave="Dz_DragLeave" Drop="Dz_Drop">
          <StackPanel>
            <DockPanel Margin="2,0,0,2" Height="24">
              <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Content="&#xE894;" Click="DzClear_Click"
                      ToolTip="Clear Dropzone" Visibility="{Binding DropItems.Count, Converter={StaticResource CountVis}}"/>
              <TextBlock x:Name="DzHeader" Text="Dropzone" Foreground="{DynamicResource SectionBrush}" FontWeight="SemiBold" FontSize="12.5"
                         VerticalAlignment="Center" Background="Transparent" PreviewMouseLeftButtonDown="DzHeader_MouseDown"
                         PreviewMouseMove="DzHeader_MouseMove" ToolTip="Drag this title to drop every item at once"/>
            </DockPanel>
            <Grid Margin="2,2,0,2" Visibility="{Binding DropItems.Count, Converter={StaticResource CountVis}, ConverterParameter=zero}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,10,0" VerticalAlignment="Top"/>
              <TextBlock Grid.Column="1" Text="Drop files here, then navigate freely" TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
            </Grid>
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl ItemsSource="{Binding DropItems}" ItemTemplate="{StaticResource DzTemplate}" Focusable="False"/>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="3" Background="{DynamicResource SplitterBg}" ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns" Focusable="False"/>

      <!-- ===================== MAIN ===================== -->
      <Grid Grid.Column="2" Background="{DynamicResource ContentBg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="48"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab bar / title bar -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="ShowSidebarBtn" Style="{StaticResource IconButton}" Content="&#xE8A0;" FontSize="14" Margin="8,0,0,0"
                  Visibility="Collapsed" ToolTip="Show sidebar" Click="ToggleSidebar_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <StackPanel x:Name="TabArea" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
            <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource TabTemplate}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                    Click="NewTab_Click" ToolTip="New tab (Ctrl+T)" WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaxBtn" Style="{StaticResource WinButton}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Style="{StaticResource WinCloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" ToolTip="Back (Alt+Left)"/>
            <Button x:Name="FwdBtn" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" ToolTip="Forward (Alt+Right)" Margin="2,0"/>
            <Button x:Name="UpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" Click="Up_Click" ToolTip="Up (Alt+Up)"/>
            <Button x:Name="StarBtn" Style="{StaticResource IconButton}" Content="&#xE734;" Click="Star_Click" ToolTip="Bookmark this folder (Ctrl+D)" Margin="2,0,0,0"/>
          </StackPanel>
          <Grid x:Name="AddressArea" Grid.Column="1" Margin="10,0,6,0" Height="34" Background="Transparent"
                MouseLeftButtonDown="AddressArea_MouseDown" Cursor="IBeam">
            <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" Cursor="Arrow" HorizontalAlignment="Left">
              <ItemsControl ItemsSource="{Binding Crumbs}" ItemTemplate="{StaticResource CrumbTemplate}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <TextBox x:Name="AddressBox" Style="{StaticResource FieldBox}" Visibility="Collapsed" Cursor="IBeam"
                     KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus"/>
          </Grid>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Refresh (F5)" VerticalAlignment="Center"/>
        </Grid>

        <!-- Command bar -->
        <Border Grid.Row="2" Margin="12,0,12,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" ClipToBounds="True">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="CmdNew" Style="{StaticResource CmdButton}" Click="CmdNew_Click" ToolTip="Create a new folder or file">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE710;"/>
                <TextBlock Text="New" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CmdChevron}"/>
              </StackPanel>
            </Button>
            <Border Style="{StaticResource CmdSep}"/>
            <Button x:Name="CmdCut" Style="{StaticResource CmdIcon}" Content="&#xE8C6;" ToolTip="Cut (Ctrl+X)" Click="CmdCut_Click"/>
            <Button x:Name="CmdCopy" Style="{StaticResource CmdIcon}" Content="&#xE8C8;" ToolTip="Copy (Ctrl+C)" Click="CmdCopy_Click"/>
            <Button x:Name="CmdPaste" Style="{StaticResource CmdIcon}" Content="&#xE77F;" ToolTip="Paste (Ctrl+V)" Click="CmdPaste_Click"/>
            <Button x:Name="CmdRename" Style="{StaticResource CmdIcon}" Content="&#xE8AC;" ToolTip="Rename (F2)" Click="CmdRename_Click"/>
            <Button x:Name="CmdShare" Style="{StaticResource CmdIcon}" Content="&#xE72D;" ToolTip="Share" Click="CmdShare_Click"/>
            <Button x:Name="CmdDelete" Style="{StaticResource CmdIcon}" Content="&#xE74D;" ToolTip="Delete (Del)" Click="CmdDelete_Click"/>
            <Button x:Name="CmdProps" Style="{StaticResource CmdIcon}" Content="&#xE946;" ToolTip="Properties (Alt+Enter)" Click="CmdProps_Click"/>
            <Border Style="{StaticResource CmdSep}"/>
            <Button x:Name="CmdSort" Style="{StaticResource CmdButton}" Click="CmdSort_Click" ToolTip="Sort">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8CB;"/>
                <TextBlock Text="Sort" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CmdChevron}"/>
              </StackPanel>
            </Button>
            <Button x:Name="CmdView" Style="{StaticResource CmdButton}" Click="CmdView_Click" ToolTip="Layout and view options">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CmdViewGlyph" Style="{StaticResource CmdGlyph}" Text="&#xE8FD;"/>
                <TextBlock Text="View" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CmdChevron}"/>
              </StackPanel>
            </Button>
            <Button x:Name="CmdFilter" Style="{StaticResource CmdButton}" Click="CmdFilter_Click" ToolTip="Show only some kinds of items">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE71C;"/>
                <TextBlock x:Name="CmdFilterText" Text="Filter" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource CmdChevron}"/>
              </StackPanel>
            </Button>
            <Border Style="{StaticResource CmdSep}"/>
            <Button x:Name="CmdMore" Style="{StaticResource CmdIcon}" Content="&#xE712;" ToolTip="More options" Click="CmdMore_Click"/>
          </StackPanel>
        </Border>

        <!-- Content -->
        <Grid x:Name="ContentHost" Grid.Row="3" Background="Transparent" AllowDrop="True"
              DragOver="Content_DragOver" DragLeave="Content_DragLeave" Drop="Content_Drop">
          <ListBox x:Name="GridList" Style="{StaticResource FlatList}" Padding="4,0"
                   ItemContainerStyle="{StaticResource GridItemStyle}" ItemTemplate="{StaticResource GridItemTemplate}"
                   SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                   VirtualizingPanel.IsVirtualizing="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                   PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseRightButtonUp="List_MouseRightButtonUp"
                   PreviewKeyDown="GridList_PreviewKeyDown" SelectionChanged="List_SelectionChanged">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <local:VirtualizingWrapPanel ItemWidth="118" ItemHeight="126"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <ListView x:Name="DetailsList" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextBrush}" Padding="8,0"
                    ItemContainerStyle="{StaticResource DetailsItemStyle}" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    IsTextSearchEnabled="True" TextSearch.TextPath="Name" FocusVisualStyle="{x:Null}"
                    PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseRightButtonUp="List_MouseRightButtonUp"
                    SelectionChanged="List_SelectionChanged" GridViewColumnHeader.Click="Header_Click">
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}" AllowsColumnReorder="False">
                <GridViewColumn x:Name="ColName" Width="400" CellTemplate="{StaticResource NameCell}"/>
                <GridViewColumn x:Name="ColDate" Width="170" CellTemplate="{StaticResource DateCell}"/>
                <GridViewColumn x:Name="ColType" Width="170" CellTemplate="{StaticResource TypeCell}"/>
                <GridViewColumn x:Name="ColSize" Width="100" CellTemplate="{StaticResource SizeCell}"/>
              </GridView>
            </ListView.View>
          </ListView>


          <!-- Tree View -->
          <Grid x:Name="TreeHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="12,0,22,4" TextElement.Foreground="{DynamicResource MutedBrush}" TextElement.FontSize="12.5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Name" Margin="34,6,0,6"/>
              <TextBlock Grid.Column="1" Text="Date modified" Margin="10,6,0,6"/>
              <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Margin="0,6,10,6"/>
              <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LineBrush}"/>
            </Grid>
            <ListBox x:Name="TreeList" Grid.Row="1" Style="{StaticResource FlatList}" Padding="0,2"
                     ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource TreeRowTemplate}"
                     SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseRightButtonUp="List_MouseRightButtonUp"
                     PreviewKeyDown="TreeList_PreviewKeyDown" SelectionChanged="List_SelectionChanged"/>
          </Grid>

          <!-- Miller Columns -->
          <Grid x:Name="ColumnsHost" Visibility="Collapsed">
            <ScrollViewer x:Name="ColumnsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="AncestorColumns" Orientation="Horizontal"/>
                <Border Width="290" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                  <ListBox x:Name="ColumnsList" Style="{StaticResource FlatList}" Padding="0,4"
                           ItemContainerStyle="{StaticResource RowItemStyle}" ItemTemplate="{StaticResource ColumnRowTemplate}"
                           SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                           IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                           PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                           PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" MouseRightButtonUp="List_MouseRightButtonUp"
                           PreviewKeyDown="ColumnsList_PreviewKeyDown" SelectionChanged="List_SelectionChanged"/>
                </Border>
                <Border x:Name="ColumnPreview" Width="340" Padding="22,18">
                  <StackPanel x:Name="ColumnPreviewPanel"/>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="EmptyGlyph" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34"
                       Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SectionBrush}" FontSize="14.5" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>

          <TextBlock x:Name="LoadingText" Text="Loading…" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>

          <!-- Shown while something can be dropped into the current folder -->
          <Border x:Name="DropOverlay" Margin="6,2,6,2" CornerRadius="12" BorderThickness="2" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" Opacity="0.35" Visibility="Collapsed"/>
          <Border x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" CornerRadius="8" Padding="12,6"
                  Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                  IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="DropHintText" Foreground="{DynamicResource TextBrush}"/>
          </Border>

          <!-- "Drop to split" target shown while a tab is dragged over the right half -->
          <Border x:Name="SplitDropZone" HorizontalAlignment="Right" Width="420" Margin="0,8,10,8" CornerRadius="12" BorderThickness="2"
                  BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBg}" Opacity="0.9"
                  IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE8A0;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SplitDropText" Text="Drop to split" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Marquee (box) selection -->
          <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="Marquee" Visibility="Collapsed" RadiusX="3" RadiusY="3" StrokeThickness="1"
                       Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource HoverBorderBrush}"/>
          </Canvas>

          <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                  Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8"
                  Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="520"/>
          </Border>
        </Grid>

        <!-- Split pane (second folder side by side) -->
        <Border x:Name="SplitHost" Grid.Row="3" HorizontalAlignment="Right" Width="460" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource ContentBg}"
                AllowDrop="True" DragOver="Split_DragOver" DragLeave="Split_DragLeave" Drop="Split_Drop">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="8,2,6,6">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="SplitBackBtn" Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13" ToolTip="Back" Click="SplitBack_Click"/>
                <Button x:Name="SplitUpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" FontSize="13" ToolTip="Up" Click="SplitUp_Click"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="13" ToolTip="Refresh" Click="SplitRefresh_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" FontSize="13" ToolTip="Swap panes" Click="SplitSwap_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Close split view (Ctrl+\)" Click="SplitClose_Click"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center" Margin="8,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SplitTitle_Click"
                          ToolTip="Open this folder in the main pane">
                <TextBlock x:Name="SplitTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SplitSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <ListBox x:Name="SplitList" Grid.Row="1" Style="{StaticResource FlatList}" Padding="0,2"
                     ItemContainerStyle="{StaticResource SplitItemStyle}" ItemTemplate="{StaticResource SplitRowTemplate}"
                     SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                     MouseDoubleClick="SplitList_DoubleClick" MouseRightButtonUp="SplitList_RightClick"
                     PreviewMouseLeftButtonDown="SplitList_PreviewMouseDown" PreviewMouseMove="SplitList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="SplitList_PreviewMouseUp" MouseUp="SplitList_MouseUp"/>
            <TextBlock x:Name="SplitEmpty" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
            <Thumb x:Name="SplitGrip" Grid.RowSpan="2" HorizontalAlignment="Left" Width="8" Margin="-4,0,0,0" Cursor="SizeWE"
                   DragDelta="SplitGrip_DragDelta" DragCompleted="SplitGrip_DragCompleted">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </Border>

        <!-- Bottom bar -->
        <Grid Grid.Row="4" Margin="12,6,12,10">
          <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Content="&#xE909;" FontSize="14" Click="FindEverywhere_Click"
                      ToolTip="Search everywhere (Ctrl+K)"/>
              <Button x:Name="SearchBtn" Style="{StaticResource IconButton}" Content="&#xE721;" FontSize="14" Click="SearchBtn_Click"
                      ToolTip="Filter this folder (Ctrl+F)"/>
              <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" Width="220" Height="28" Margin="2,0,4,0"
                       Visibility="Collapsed" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                       LostKeyboardFocus="SearchBox_LostFocus"/>
              <ToggleButton x:Name="HiddenToggle" Style="{StaticResource IconToggle}" Content="&#xE7B3;" FontSize="14"
                            Click="HiddenToggle_Click" ToolTip="Show hidden items (Ctrl+H)"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SelText" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,6,0" Visibility="Collapsed"/>
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,6,0" ToolTip="Folders"/>
              <TextBlock x:Name="FolderCount" Text="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" ToolTip="Files"/>
              <TextBlock x:Name="FileCount" Text="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource IconButton}" Content="&#xE8CB;" FontSize="14" Click="Sort_Click" ToolTip="Sort"/>
              <Button x:Name="ViewBtn" Style="{StaticResource IconButton}" Content="&#xE8FD;" FontSize="14" Click="ViewToggle_Click" ToolTip="Switch view"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ===================== QUICK PREVIEW (Space) ===================== -->
      <Grid x:Name="PreviewOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#B0000000"
            MouseLeftButtonDown="PreviewBackdrop_MouseDown">
        <Border x:Name="PreviewCard" Margin="70,56,70,40" MaxWidth="1180" CornerRadius="14" BorderThickness="1"
                Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource LineBrush}"
                MouseLeftButtonDown="PreviewCard_MouseDown">
          <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="Black"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Padding="16,12,10,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="PvOpenBtn" Style="{StaticResource DlgButton}" Focusable="False" Content="Open" Click="PvOpen_Click" MinWidth="0" Padding="14,6"/>
                  <Button Style="{StaticResource IconButton}" Content="&#xE7AC;" ToolTip="Open with…" Click="PvOpenWith_Click" Margin="6,0,0,0"/>
                  <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Close (Space / Esc)" Click="PvClose_Click" Margin="2,0,0,0"/>
                </StackPanel>
                <Image x:Name="PvIcon" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="PvName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="PvMeta" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- content -->
            <Grid x:Name="PvHost" Grid.Row="1" ClipToBounds="True" Background="{DynamicResource SidebarBg}">
              <Image x:Name="PvImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="16" Visibility="Collapsed"
                     RenderOptions.BitmapScalingMode="HighQuality"/>

              <TextBox x:Name="PvText" Visibility="Collapsed" IsReadOnly="True" BorderThickness="0" Padding="16,12"
                       Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                       SelectionBrush="{DynamicResource AccentBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap"/>

              <Grid x:Name="PvMediaHost" Visibility="Collapsed">
                <MediaElement x:Name="PvMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Margin="8"
                              MediaOpened="PvMedia_Opened" MediaEnded="PvMedia_Ended" MediaFailed="PvMedia_Failed"/>
                <TextBlock x:Name="PvAudioGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="90"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>

              <ScrollViewer x:Name="PvPages" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PvPagesPanel" Margin="24,16"/>
              </ScrollViewer>

              <ListView x:Name="PvList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="10,6"
                        Foreground="{DynamicResource TextBrush}" Focusable="False">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border Padding="0,3"><GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"/></Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                  <GridView ColumnHeaderContainerStyle="{StaticResource HeaderStyle}">
                    <GridViewColumn Header="Name" Width="520">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="110">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Size}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="PvListExtraCol" Header="Packed" Width="110">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Extra}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>

              <StackPanel x:Name="PvInfo" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <Image x:Name="PvInfoImage" Width="256" Height="256" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="PvInfoText" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>

              <TextBlock x:Name="PvLoading" Text="Loading preview…" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="2" Padding="16,9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
              <DockPanel>
                <StackPanel x:Name="PvMediaBar" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,16,0">
                  <Button x:Name="PvPlayBtn" Style="{StaticResource IconButton}" Content="&#xE769;" Click="PvPlay_Click" ToolTip="Play / pause"/>
                  <Slider x:Name="PvSeek" Width="320" VerticalAlignment="Center" Margin="8,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                          Thumb.DragStarted="PvSeek_DragStarted" Thumb.DragCompleted="PvSeek_DragCompleted" PreviewMouseLeftButtonUp="PvSeek_MouseUp"/>
                  <TextBlock x:Name="PvTime" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="PvHint" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="Space or Esc to close  ·  arrow keys for next / previous"/>
                <TextBlock x:Name="PvNote" VerticalAlignment="Center" Foreground="{DynamicResource SectionBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ===================== FIND ANYTHING (Ctrl+K) ===================== -->
      <Grid x:Name="SearchOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#99000000"
            MouseLeftButtonDown="SearchBackdrop_MouseDown">
        <Border x:Name="SearchCard" Width="820" Margin="0,70,0,60" VerticalAlignment="Top" CornerRadius="16" BorderThickness="1"
                Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource LineBrush}" MouseLeftButtonDown="SearchCard_MouseDown">
          <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="Black"/>
          </Border.Effect>
          <StackPanel>
            <!-- query -->
            <Grid Margin="20,14,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
              <TextBox x:Name="FindBox" AutomationProperties.Name="Find anything" Grid.Column="1" FontSize="20" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                       VerticalContentAlignment="Center" TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Grid>
                      <TextBlock x:Name="Placeholder" Text="Search every file and folder…" Foreground="{DynamicResource FaintBrush}"
                                 VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Text" Value="">
                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="FindTime" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="12,0"/>
                <TextBlock x:Name="FindCount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>

            <!-- kind chips -->
            <Border Background="{DynamicResource PanelBg}" CornerRadius="9" Padding="2" HorizontalAlignment="Left" Margin="18,0,0,10">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FindAll" Style="{StaticResource Seg}" Content="All" GroupName="findkind" IsChecked="True" Click="FindKind_Click" Focusable="False"/>
                <RadioButton x:Name="FindFolders" Style="{StaticResource Seg}" Content="Folders" GroupName="findkind" Click="FindKind_Click" Focusable="False"/>
                <RadioButton x:Name="FindFiles" Style="{StaticResource Seg}" Content="Files" GroupName="findkind" Click="FindKind_Click" Focusable="False"/>
              </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource LineBrush}"/>

            <!-- results -->
            <Grid>
              <ListBox x:Name="FindResults" MaxHeight="460" Background="Transparent" BorderThickness="0" Padding="8,6"
                       Foreground="{DynamicResource TextBrush}" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="FindResults_DoubleClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" CornerRadius="10" Padding="12,8" Margin="0,1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBg}"/>
                              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:SearchHit}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <TextBlock Grid.Column="1" local:HighlightText.Segments="{Binding Segments}" FontSize="15" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Where}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                 VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="330" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="FindEmpty" Margin="24,22" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>

            <!-- footer -->
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9">
              <DockPanel>
                <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="↑↓ choose  ·  Enter open  ·  Ctrl+Enter show in folder  ·  Esc close"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
