<Window x:Class="Orbit.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert" Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <StackPanel>
      <DockPanel Height="44" Margin="20,0,6,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="Close_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="Convert" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Margin="32,4,32,26">
        <TextBlock Text="Convert anything" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="Subtitle" Foreground="{DynamicResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,18"/>

        <!-- source summary -->
        <Border CornerRadius="16" Padding="18,14" BorderThickness="1" HorizontalAlignment="Center" MinWidth="360"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="SrcIcon" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SrcName" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
              <TextBlock x:Name="SrcInfo" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Border x:Name="SavingChip" Margin="18,0,0,0" CornerRadius="10" Padding="10,4" VerticalAlignment="Center" Visibility="Collapsed"
                    Background="{DynamicResource SelectedBg}">
              <TextBlock x:Name="SavingText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Border>

        <!-- format cards -->
        <WrapPanel x:Name="FormatCards" HorizontalAlignment="Center" Margin="0,22,0,0"/>

        <!-- options -->
        <StackPanel x:Name="ImageOptions" Margin="0,14,0,0">
          <DockPanel x:Name="QualityRow" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Quality" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="QualityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="QualitySlider" Minimum="40" Maximum="100" Value="82" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                    ValueChanged="Quality_Changed" IsSnapToTickEnabled="True" TickFrequency="1"/>
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Size" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <Border Background="{DynamicResource PanelBg}" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SizeKeep" Style="{StaticResource Seg}" Content="Original" GroupName="size" IsChecked="True" Click="Size_Click"/>
                <RadioButton Style="{StaticResource Seg}" Content="Max 3840 px" GroupName="size" Tag="3840" Click="Size_Click"/>
                <RadioButton Style="{StaticResource Seg}" Content="Max 1920 px" GroupName="size" Tag="1920" Click="Size_Click"/>
                <RadioButton Style="{StaticResource Seg}" Content="Max 1280 px" GroupName="size" Tag="1280" Click="Size_Click"/>
              </StackPanel>
            </Border>
          </DockPanel>
        </StackPanel>

        <Border x:Name="FfmpegNote" Margin="0,16,0,0" CornerRadius="10" Padding="14,10" BorderThickness="1" Visibility="Collapsed"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DlgButton}" Content="Get ffmpeg" Click="GetFfmpeg_Click" VerticalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Video and audio conversion uses ffmpeg, a free tool that isn't installed yet. Install it (for example: winget install ffmpeg), then open Convert again."/>
          </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button Style="{StaticResource DlgButton}" Content="Close" Click="Close_Click"/>
          <Button x:Name="ConvertBtn" Style="{StaticResource DlgButton}" Margin="10,0,0,0" Click="Convert_Click" FontWeight="SemiBold"
                  Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource ContentBg}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
