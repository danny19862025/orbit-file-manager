<Window x:Class="Orbit.SpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk space" Width="1100" Height="760" MinWidth="720" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ContentBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <DockPanel Height="44" Margin="18,0,6,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Click="Close_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE922;" FontSize="10" Click="Max_Click" Margin="0,0,2,0"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="Disk space" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>

      <!-- header -->
      <Grid Grid.Row="1" Margin="32,6,32,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Where your space goes" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="See what fills a drive or folder. Click a bubble to see what it is; double-click a folder to look inside." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,4,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="UpBtn" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Up one level" Click="Up_Click"/>
            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Width="420" Padding="18,14" CornerRadius="14" BorderThickness="1" VerticalAlignment="Top"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="DriveFree" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="DriveName" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Height="8" Margin="0,12,0,0">
              <Border CornerRadius="4" Background="{DynamicResource TrackBrush}"/>
              <Border x:Name="DriveUsed" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource MutedBrush}" Opacity="0.7"/>
              <Border x:Name="DriveSelected" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- bubbles -->
      <Grid Grid.Row="2" Margin="20,0,20,0">
        <Canvas x:Name="Bubbles" ClipToBounds="True" Background="Transparent" SizeChanged="Bubbles_SizeChanged"/>
        <StackPanel x:Name="ScanPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock x:Name="ScanText" Foreground="{DynamicResource MutedBrush}" FontSize="15" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <!-- footer -->
      <DockPanel Grid.Row="3" Margin="32,10,32,24">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
        <Border DockPanel.Dock="Right" CornerRadius="16" Padding="22,10,10,10" BorderThickness="1" HorizontalAlignment="Right"
                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}">
          <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
              <TextBlock x:Name="SelTitle" Text="Nothing selected" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock x:Name="SelSub" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
            </StackPanel>
            <Button x:Name="ShowBtn" Style="{StaticResource DlgButton}" IsEnabled="False" Click="Show_Click" Padding="22,11"
                    Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource ContentBg}" FontWeight="SemiBold" FontSize="14">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Show in Orbit"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </DockPanel>
    </Grid>
  </Border>
</Window>
