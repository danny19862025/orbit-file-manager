<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Orbit"
             x:Class="Orbit.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Palette: placeholders only. Themes.Apply() replaces every brush at startup and on theme change. -->
    <SolidColorBrush x:Key="SidebarBg" Color="#181825"/>
    <SolidColorBrush x:Key="ContentBg" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="PanelBg" Color="#272739"/>
    <SolidColorBrush x:Key="MenuBg" Color="#272739"/>
    <SolidColorBrush x:Key="HoverBg" Color="#313244"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#33364F"/>
    <SolidColorBrush x:Key="LineBrush" Color="#45475A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="SectionBrush" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#CBA6F7"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#80B4BEFE"/>
    <SolidColorBrush x:Key="SelBorderBrush" Color="#B4BEFE"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#55CBA6F7"/>
    <SolidColorBrush x:Key="InputBg" Color="#11111B"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#313244"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#45475A"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#585B70"/>
    <SolidColorBrush x:Key="RootBorder" Color="#11111B"/>
    <SolidColorBrush x:Key="SplitterBg" Color="#11111B"/>
    <SolidColorBrush x:Key="DropzoneBg" Color="#1B1B29"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#585B70"/>
    <SolidColorBrush x:Key="ToastBg" Color="#313244"/>

    <FontFamily x:Key="UiFont">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="IconFont">avares://orbit/Assets/Fonts#Orbit Icons</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Noto Sans Mono, monospace</FontFamily>

    <local:BoolToOpacityConverter x:Key="HiddenOpacity"/>

    <!-- one flat template for every button style below; states are set with style selectors -->
    <ControlTemplate x:Key="FlatButton" TargetType="Button">
      <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter Name="CP" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="FlatToggle" TargetType="ToggleButton">
      <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    </Style>

    <!-- ===== Icon buttons ===== -->
    <Style Selector="Button.icon">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Button.icon:pressed"><Setter Property="Background" Value="{DynamicResource SelectedBg}"/></Style>
    <Style Selector="Button.icon:disabled"><Setter Property="Opacity" Value="0.3"/></Style>
    <Style Selector="Button.small">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.crumbChev">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>

    <!-- window caption buttons -->
    <Style Selector="Button.win">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.win:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Button.win:pressed"><Setter Property="Background" Value="{DynamicResource SelectedBg}"/></Style>
    <Style Selector="Button.winClose:pointerover"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.winClose:pressed"><Setter Property="Background" Value="#B70E1C"/><Setter Property="Foreground" Value="White"/></Style>

    <!-- toggle with an icon (show hidden items) -->
    <Style Selector="ToggleButton.icon">
      <Setter Property="Template" Value="{StaticResource FlatToggle}"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="ToggleButton.icon:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="ToggleButton.icon:checked">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- sidebar section header ("Places ˅") -->
    <Style Selector="ToggleButton.section">
      <Setter Property="Foreground" Value="{DynamicResource SectionBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,12,0,2"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsChecked" Value="True"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{TemplateBinding Background}" Padding="8,5,10,5" CornerRadius="6">
            <DockPanel>
              <TextBlock Name="Chev" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                         VerticalAlignment="Center" RenderTransformOrigin="50%,50%"/>
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.section:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="ToggleButton.section:unchecked /template/ TextBlock#Chev">
      <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
    </Style>

    <!-- sidebar entries -->
    <Style Selector="Button.side">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="8,0,10,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Button.side:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Button.side.active">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- breadcrumbs -->
    <Style Selector="Button.crumb">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.crumb:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>

    <!-- command bar -->
    <Style Selector="Button.cmd">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.cmd:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Button.cmd:pressed"><Setter Property="Background" Value="{DynamicResource SelectedBg}"/></Style>
    <Style Selector="Button.cmd:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
    <Style Selector="Button.cmdIcon">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="TextBlock.cmdGlyph">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.cmdChev">
      <Setter Property="Text" Value="&#xE70D;"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style Selector="Border.cmdSep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- text boxes -->
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ContentBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.field:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBox.input">
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="Height" Value="34"/>
    </Style>
    <Style Selector="TextBox.input:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBg}"/></Style>
    <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBg}"/></Style>
    <Style Selector="TextBox.rename">
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="TextBox.rename:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="TextBox.rename:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource InputBg}"/></Style>
    <!-- read-only value fields (Properties) -->
    <Style Selector="TextBox.val">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBox.val /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox.val:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox.val:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox.val:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>

    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- drive usage bar -->
    <Style Selector="ProgressBar.usage">
      <Setter Property="Height" Value="3"/>
      <Setter Property="MinHeight" Value="3"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2"/>
            <Border Name="PART_Indicator" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- flat lists -->
    <Style Selector="ListBox.flat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="SelectionMode" Value="Multiple"/>
    </Style>
    <Style Selector="ListBox.flat ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.flat ListBoxItem:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    </Style>
    <Style Selector="ListBox.hoverBorder ListBoxItem:pointerover /template/ Border#Bd">
      <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
    </Style>
    <Style Selector="ListBox.flat ListBoxItem:selected /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
    </Style>
    <Style Selector="ListBox.flat ListBoxItem.drop /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.details ListBoxItem">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.results ListBoxItem">
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.results ListBoxItem:selected /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ Border#Bd"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ Border#Bd"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>

    <!-- segmented choice -->
    <Style Selector="RadioButton.seg">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,6" Margin="2">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.seg:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="RadioButton.seg:checked">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- settings navigation -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="26" VerticalAlignment="Center"/>
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="RadioButton.nav:checked">
      <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- check box -->
    <Style Selector="CheckBox.check">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource InputBg}">
              <TextBlock Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Foreground="{DynamicResource ContentBg}"/>
            </Border>
            <ContentPresenter Name="CP" Content="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.check:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="CheckBox.check:checked /template/ TextBlock#Tick"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="CheckBox.check:indeterminate /template/ Border#Box"><Setter Property="Background" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="CheckBox.check:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

    <!-- dialog buttons -->
    <Style Selector="Button.dlg">
      <Setter Property="Template" Value="{StaticResource FlatButton}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.dlg:pointerover /template/ Border#Bd"><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="Button.dlg:disabled /template/ Border#Bd"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ContentBg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- menus -->
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MaxHeight" Value="560"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="6,6,8,6"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="MenuItem:open /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="MenuItem:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="MenuItem /template/ Popup > Border">
      <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem /template/ Path#PART_ChevronPath"><Setter Property="Fill" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Margin" Value="8,4"/>
      <Setter Property="Height" Value="1"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource MenuBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource ThumbBrush}"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThumbHoverBrush}"/>
    </Style>

    <Style Selector="GridSplitter">
      <Setter Property="MinWidth" Value="3"/>
    </Style>
  </Application.Styles>
</Application>
