<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Orbit"
        x:Class="Orbit.MainWindow"
        Title="Orbit" Width="1240" Height="800" MinWidth="720" MinHeight="420"
        SystemDecorations="None" Background="{DynamicResource SidebarBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="avares://orbit/Assets/orbit.png">

  <Window.Resources>
    <!-- Sidebar entry -->
    <DataTemplate x:Key="SideTemplate" x:DataType="local:SideItem">
      <Button Classes="side" Classes.active="{Binding IsActive}" Tag="{Binding}" Click="SideItem_Click"
              PointerReleased="SideItem_PointerReleased" DragDrop.AllowDrop="True"
              ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="900">
        <Grid ColumnDefinitions="28,*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"
                     IsVisible="{Binding HasGlyph}"/>
          <Ellipse Width="10" Height="10" Fill="{Binding TagBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"
                   IsVisible="{Binding IsTagItem}"/>
          <DockPanel Grid.Column="1" LastChildFill="False">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="7,1,0,0" VerticalAlignment="Center" ToolTip.Tip="Connected"
                     IsVisible="{Binding IsConnected}"/>
          </DockPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                    Background="{DynamicResource HoverBg}" VerticalAlignment="Center" IsVisible="{Binding HasBadge}">
              <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
          </StackPanel>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Classes="usage" Value="{Binding Usage}" Margin="0,2,0,6" IsVisible="{Binding ShowUsage}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Miller Columns rows -->
    <DataTemplate x:Key="ColumnRowTemplate" x:DataType="local:FileItem">
      <DockPanel Opacity="{Binding ItemOpacity}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1200">
        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding IsDir}"/>
        <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        <Grid>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding NameVisible}"/>
          <TextBox Classes="field rename" Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"/>
        </Grid>
      </DockPanel>
    </DataTemplate>

    <!-- Tag dots -->
    <DataTemplate x:Key="TagDot">
      <Ellipse Width="9" Height="9" Fill="{Binding}" Margin="2,0,0,0"/>
    </DataTemplate>
  </Window.Resources>

  <Panel>
    <Border x:Name="Root" BorderBrush="{DynamicResource RootBorder}" BorderThickness="1">
      <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" MinWidth="180" MaxWidth="480"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Grid x:Name="Sidebar" Background="{DynamicResource SidebarBg}" RowDefinitions="48,*,Auto" DragDrop.AllowDrop="True">
          <DockPanel x:Name="SidebarHead" Margin="16,4,8,0" Background="Transparent">
            <Button DockPanel.Dock="Right" Classes="icon" Content="&#xE89F;" FontSize="14" ToolTip.Tip="Hide sidebar" Click="ToggleSidebar_Click"/>
            <Button DockPanel.Dock="Right" Classes="icon" Content="&#xE713;" FontSize="14" Margin="0,0,2,0" ToolTip.Tip="Settings (Ctrl+,)" Click="Settings_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- the app icon, drawn live so its moon can travel round the ring once when Orbit opens (MainWindow.Intro.cs) -->
              <Canvas x:Name="TitleIcon" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="50%,50%"/>
              <TextBlock Text="Orbit" FontWeight="SemiBold" FontSize="15.5" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,8">
              <ToggleButton x:Name="TglPlaces" Classes="section" Content="Places" Margin="0,2,0,2"/>
              <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource SideTemplate}" IsVisible="{Binding #TglPlaces.IsChecked}"/>
              <Border x:Name="PlacesDropHint" IsVisible="False" DragDrop.AllowDrop="True" Margin="0,4,0,2" Padding="10,8" CornerRadius="8"
                      BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBg}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Text="Drop here to add to Places" Foreground="{DynamicResource AccentBrush}" FontSize="12.5"/>
                </StackPanel>
              </Border>

              <StackPanel x:Name="SecBookmarks">
                <ToggleButton x:Name="TglBookmarks" Classes="section" Content="Bookmarks"/>
                <StackPanel IsVisible="{Binding #TglBookmarks.IsChecked}">
                  <TextBlock x:Name="NoBookmarks" Text="No bookmarks — press ☆ or Ctrl+D" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="10,4,0,4"/>
                  <ItemsControl ItemsSource="{Binding Bookmarks}" ItemTemplate="{StaticResource SideTemplate}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="SecTags">
                <ToggleButton x:Name="TglTags" Classes="section" Content="Tags"/>
                <StackPanel IsVisible="{Binding #TglTags.IsChecked}">
                  <TextBlock x:Name="NoTags" Text="No tags — right-click a file › Tags" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="10,4,0,4"/>
                  <ItemsControl ItemsSource="{Binding TagItems}" ItemTemplate="{StaticResource SideTemplate}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="SecDrives">
                <ToggleButton x:Name="TglDrives" Classes="section" Content="Drives"/>
                <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource SideTemplate}" IsVisible="{Binding #TglDrives.IsChecked}"/>
              </StackPanel>

              <StackPanel x:Name="SecNetwork">
                <StackPanel x:Name="NetworkBlock">
                  <ToggleButton x:Name="TglNetwork" Classes="section" Content="Network"/>
                  <ItemsControl ItemsSource="{Binding Network}" ItemTemplate="{StaticResource SideTemplate}" IsVisible="{Binding #TglNetwork.IsChecked}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="SecRecent">
                <StackPanel x:Name="RecentBlock">
                  <ToggleButton x:Name="TglRecent" Classes="section" Content="Recent"/>
                  <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource SideTemplate}" IsVisible="{Binding #TglRecent.IsChecked}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Dropzone -->
          <Border x:Name="DropzoneBorder" Grid.Row="2" Margin="8,4,8,10" CornerRadius="10" Background="{DynamicResource DropzoneBg}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8,6,6,8" DragDrop.AllowDrop="True">
            <StackPanel>
              <DockPanel Margin="2,0,0,2" Height="24">
                <Button x:Name="DzClearBtn" DockPanel.Dock="Right" Classes="icon small" Content="&#xE894;" Click="DzClear_Click" ToolTip.Tip="Clear Dropzone"/>
                <TextBlock x:Name="DzHeader" Text="Dropzone" Foreground="{DynamicResource SectionBrush}" FontWeight="SemiBold" FontSize="12.5"
                           VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="Drag this title to drop every item at once"/>
              </DockPanel>
              <Grid x:Name="DzEmpty" Margin="2,2,0,2" ColumnDefinitions="Auto,*">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,10,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="Drop files here, then navigate freely" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
              </Grid>
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DzList" ItemsSource="{Binding DropItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FileItem">
                      <Border Classes="dz" Background="Transparent" CornerRadius="6" Padding="6,3" Tag="{Binding}" ToolTip.Tip="{Binding FullPath}">
                        <Grid ColumnDefinitions="24,*,Auto">
                          <Image Source="{Binding SmallIcon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"/>
                          <Button Grid.Column="2" Classes="icon small dzx" Content="&#xE711;" Tag="{Binding}" Click="DzRemove_Click" ToolTip.Tip="Remove from Dropzone"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="3" Background="{DynamicResource SplitterBg}" ResizeDirection="Columns" Focusable="False"/>

        <!-- ===================== MAIN ===================== -->
        <Grid x:Name="MainArea" Grid.Column="2" Background="{DynamicResource ContentBg}" RowDefinitions="40,48,Auto,*,Auto">

          <!-- Tab bar / title bar -->
          <Grid x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto" Background="Transparent">
            <Button x:Name="ShowSidebarBtn" Classes="icon" Content="&#xE8A0;" FontSize="14" Margin="8,0,0,0" IsVisible="False" ToolTip.Tip="Show sidebar" Click="ToggleSidebar_Click"/>
            <StackPanel x:Name="TabArea" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
              <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" HorizontalAlignment="Left"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:TabState">
                    <Border Classes="tab" Classes.active="{Binding IsActive}" Height="40" MinWidth="40" MaxWidth="220" Background="Transparent" Tag="{Binding}"
                            ToolTip.Tip="{Binding Path}" ToolTip.ShowDelay="900" DragDrop.AllowDrop="True">
                      <Grid>
                        <Grid Margin="12,0,6,0" ColumnDefinitions="*,Auto">
                          <TextBlock Classes="tabText" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
                          <Button Classes="icon small tabClose" Grid.Column="1" Content="&#xE711;" Margin="8,0,0,0" Click="TabClose_Click" Tag="{Binding}"/>
                        </Grid>
                        <Border Classes="underline" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" CornerRadius="1" Margin="4,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="icon" Content="&#xE710;" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" Click="NewTab_Click" ToolTip.Tip="New tab (Ctrl+T)"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Classes="win" Content="&#xE921;" Click="Min_Click"/>
              <Button x:Name="MaxBtn" Classes="win" Content="&#xE922;" Click="Max_Click"/>
              <Button Classes="win winClose" Content="&#xE8BB;" Click="Close_Click"/>
            </StackPanel>
          </Grid>

          <!-- Toolbar -->
          <Grid Grid.Row="1" Margin="12,0,12,0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BackBtn" Classes="icon" Content="&#xE72B;" Click="Back_Click" ToolTip.Tip="Back (Alt+Left)"/>
              <Button x:Name="FwdBtn" Classes="icon" Content="&#xE72A;" Click="Forward_Click" ToolTip.Tip="Forward (Alt+Right)" Margin="2,0"/>
              <Button x:Name="UpBtn" Classes="icon" Content="&#xE74A;" Click="Up_Click" ToolTip.Tip="Up (Alt+Up)"/>
              <Button x:Name="StarBtn" Classes="icon" Content="&#xE734;" Click="Star_Click" ToolTip.Tip="Bookmark this folder (Ctrl+D)" Margin="2,0,0,0"/>
            </StackPanel>
            <Grid x:Name="AddressArea" Grid.Column="1" Margin="10,0,6,0" Height="34" Background="Transparent" Cursor="IBeam">
              <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Cursor="Arrow" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:Crumb">
                      <StackPanel Orientation="Horizontal">
                        <Button Classes="crumb" Content="{Binding Name}" Click="Crumb_Click" Tag="{Binding}" DragDrop.AllowDrop="True"/>
                        <Button Classes="icon crumbChev" Content="&#xE76C;" Click="CrumbChevron_Click" Tag="{Binding}" ToolTip.Tip="Subfolders" IsVisible="{Binding HasChevron}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox x:Name="AddressBox" Classes="field" IsVisible="False" Cursor="IBeam"/>
            </Grid>
            <Button Grid.Column="2" Classes="icon" Content="&#xE72C;" Click="Refresh_Click" ToolTip.Tip="Refresh (F5)" VerticalAlignment="Center"/>
          </Grid>

          <!-- Command bar -->
          <Border Grid.Row="2" Margin="12,0,12,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CmdNew" Classes="cmd" Click="CmdNew_Click" ToolTip.Tip="Create a new folder or file">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="cmdGlyph" Text="&#xE710;"/>
                  <TextBlock Text="New" Margin="8,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Classes="cmdChev"/>
                </StackPanel>
              </Button>
              <Border Classes="cmdSep"/>
              <Button x:Name="CmdCut" Classes="cmd cmdIcon" Content="&#xE8C6;" ToolTip.Tip="Cut (Ctrl+X)" Click="CmdCut_Click"/>
              <Button x:Name="CmdCopy" Classes="cmd cmdIcon" Content="&#xE8C8;" ToolTip.Tip="Copy (Ctrl+C)" Click="CmdCopy_Click"/>
              <Button x:Name="CmdPaste" Classes="cmd cmdIcon" Content="&#xE77F;" ToolTip.Tip="Paste (Ctrl+V)" Click="CmdPaste_Click"/>
              <Button x:Name="CmdRename" Classes="cmd cmdIcon" Content="&#xE8AC;" ToolTip.Tip="Rename (F2)" Click="CmdRename_Click"/>
              <Button x:Name="CmdShare" Classes="cmd cmdIcon" Content="&#xE72D;" ToolTip.Tip="Share" Click="CmdShare_Click"/>
              <Button x:Name="CmdDelete" Classes="cmd cmdIcon" Content="&#xE74D;" ToolTip.Tip="Delete (Del)" Click="CmdDelete_Click"/>
              <Button x:Name="CmdProps" Classes="cmd cmdIcon" Content="&#xE946;" ToolTip.Tip="Properties (Alt+Enter)" Click="CmdProps_Click"/>
              <Border Classes="cmdSep"/>
              <Button x:Name="CmdSort" Classes="cmd" Click="CmdSort_Click" ToolTip.Tip="Sort">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="cmdGlyph" Text="&#xE8CB;"/>
                  <TextBlock Text="Sort" Margin="8,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Classes="cmdChev"/>
                </StackPanel>
              </Button>
              <Button x:Name="CmdView" Classes="cmd" Click="CmdView_Click" ToolTip.Tip="Layout and view options">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="CmdViewGlyph" Classes="cmdGlyph" Text="&#xE8FD;"/>
                  <TextBlock Text="View" Margin="8,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Classes="cmdChev"/>
                </StackPanel>
              </Button>
              <Button x:Name="CmdFilter" Classes="cmd" Click="CmdFilter_Click" ToolTip.Tip="Show only some kinds of items">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Classes="cmdGlyph" Text="&#xE71C;"/>
                  <TextBlock x:Name="CmdFilterText" Text="Filter" Margin="8,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Classes="cmdChev"/>
                </StackPanel>
              </Button>
              <Border Classes="cmdSep"/>
              <Button x:Name="CmdMore" Classes="cmd cmdIcon" Content="&#xE712;" ToolTip.Tip="More options" Click="CmdMore_Click"/>
            </StackPanel>
          </Border>

          <!-- Content -->
          <Grid x:Name="ContentHost" Grid.Row="3" Background="Transparent" DragDrop.AllowDrop="True">
            <ListBox x:Name="GridList" Classes="flat tiles hoverBorder" Padding="4,0" SelectionMode="Multiple" IsTextSearchEnabled="True">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><local:VirtualizingWrapPanel ItemWidth="118" ItemHeight="126"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:FileItem">
                  <Grid RowDefinitions="70,*" Opacity="{Binding ItemOpacity}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1000">
                    <Image Source="{Binding LargeIcon}" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding TagBrushes}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><Ellipse Width="10" Height="10" Fill="{Binding}" Margin="-2,0,0,0" Stroke="{DynamicResource ContentBg}" StrokeThickness="1.5"/></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                               TextAlignment="Center" Margin="2,2,2,0" LineHeight="17" IsVisible="{Binding NameVisible}"/>
                    <TextBox Grid.Row="1" Classes="field rename" Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"
                             TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Top" AcceptsReturn="False"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Details -->
            <Grid x:Name="DetailsHost" IsVisible="False" RowDefinitions="Auto,*">
              <StackPanel x:Name="DetailsHeader" Orientation="Horizontal" Margin="8,0,8,2" Height="34"/>
              <ListBox x:Name="DetailsList" Grid.Row="1" Classes="flat details hoverBorder" Padding="8,0" SelectionMode="Multiple" IsTextSearchEnabled="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:FileItem">
                    <StackPanel Orientation="Horizontal" Opacity="{Binding ItemOpacity}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1200">
                      <Grid Width="{Binding NameWidth, Source={x:Static local:DetailsColumns.Instance}}" ColumnDefinitions="26,*,Auto" Margin="10,0,0,0">
                        <Image Source="{Binding SmallIcon}" Width="16" Height="16" HorizontalAlignment="Left" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding NameVisible}"/>
                        <TextBox Grid.Column="1" Classes="field rename" Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding TagBrushes}" ItemTemplate="{StaticResource TagDot}" Margin="6,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </Grid>
                      <TextBlock Width="{Binding DateWidth, Source={x:Static local:DetailsColumns.Instance}}" Padding="10,0" Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <TextBlock Width="{Binding TypeWidth, Source={x:Static local:DetailsColumns.Instance}}" Padding="10,0" Text="{Binding TypeName}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <TextBlock Width="{Binding SizeWidth, Source={x:Static local:DetailsColumns.Instance}}" Padding="10,0" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- Tree View -->
            <Grid x:Name="TreeHost" IsVisible="False" RowDefinitions="Auto,*">
              <Grid Margin="12,0,22,4" ColumnDefinitions="*,170,100">
                <TextBlock Text="Name" Margin="34,6,0,6" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                <TextBlock Grid.Column="1" Text="Date modified" Margin="10,6,0,6" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                <TextBlock Grid.Column="2" Text="Size" HorizontalAlignment="Right" Margin="0,6,10,6" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource LineBrush}"/>
              </Grid>
              <ListBox x:Name="TreeList" Grid.Row="1" Classes="flat rows" Padding="0,2" SelectionMode="Multiple" IsTextSearchEnabled="True">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:FileItem">
                    <Grid ColumnDefinitions="*,170,100" Opacity="{Binding ItemOpacity}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1200">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="{Binding TreeIndent}"/>
                        <Grid DockPanel.Dock="Left" Width="22">
                          <Button Classes="icon small" Width="20" Height="20" FontSize="9" Content="{Binding ChevronGlyph}" Tag="{Binding}" Click="TreeChevron_Click" IsVisible="{Binding IsDir}"/>
                        </Grid>
                        <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="4,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TagBrushes}" ItemTemplate="{StaticResource TagDot}" Margin="6,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding NameVisible}"/>
                          <TextBox Classes="field rename" Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"/>
                        </Grid>
                      </DockPanel>
                      <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- Miller Columns -->
            <Grid x:Name="ColumnsHost" IsVisible="False">
              <ScrollViewer x:Name="ColumnsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                  <StackPanel x:Name="AncestorColumns" Orientation="Horizontal"/>
                  <Border Width="290" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <ListBox x:Name="ColumnsList" Classes="flat rows" Padding="0,4" SelectionMode="Multiple" IsTextSearchEnabled="True"
                             ItemTemplate="{StaticResource ColumnRowTemplate}"/>
                  </Border>
                  <Border x:Name="ColumnPreview" Width="340" Padding="22,18">
                    <StackPanel x:Name="ColumnPreviewPanel"/>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" IsVisible="False">
              <TextBlock x:Name="EmptyGlyph" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="34"
                         Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
              <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SectionBrush}" FontSize="14.5" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>

            <TextBlock x:Name="LoadingText" Text="Loading…" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" IsHitTestVisible="False"/>

            <!-- Shown while something can be dropped into the current folder -->
            <Border x:Name="DropOverlay" Margin="6,2,6,2" CornerRadius="12" BorderThickness="2" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" Opacity="0.35" IsVisible="False"/>
            <Border x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" CornerRadius="8" Padding="12,6"
                    Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" IsHitTestVisible="False" IsVisible="False">
              <TextBlock x:Name="DropHintText" Foreground="{DynamicResource TextBrush}"/>
            </Border>

            <!-- "Drop to split" target shown while a tab is dragged over the right half -->
            <Border x:Name="SplitDropZone" HorizontalAlignment="Right" Width="420" Margin="0,8,10,8" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBg}" Opacity="0.9" IsHitTestVisible="False" IsVisible="False">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A0;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplitDropText" Text="Drop to split" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Marquee (box) selection -->
            <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False" ClipToBounds="True">
              <Rectangle x:Name="Marquee" IsVisible="False" RadiusX="3" RadiusY="3" StrokeThickness="1"
                         Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource HoverBorderBrush}"/>
            </Canvas>

            <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                    Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8"
                    IsVisible="False" IsHitTestVisible="False">
              <TextBlock x:Name="ToastText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxWidth="520"/>
            </Border>
          </Grid>

          <!-- Split pane (second folder side by side) -->
          <Border x:Name="SplitHost" Grid.Row="3" HorizontalAlignment="Right" Width="460" IsVisible="False"
                  BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource ContentBg}" DragDrop.AllowDrop="True">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="8,2,6,6">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                  <Button x:Name="SplitBackBtn" Classes="icon" Content="&#xE72B;" FontSize="13" ToolTip.Tip="Back" Click="SplitBack_Click"/>
                  <Button x:Name="SplitUpBtn" Classes="icon" Content="&#xE74A;" FontSize="13" ToolTip.Tip="Up" Click="SplitUp_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Classes="icon" Content="&#xE72C;" FontSize="13" ToolTip.Tip="Refresh" Click="SplitRefresh_Click"/>
                  <Button Classes="icon" Content="&#xE8AB;" FontSize="13" ToolTip.Tip="Swap panes" Click="SplitSwap_Click"/>
                  <Button Classes="icon" Content="&#xE711;" FontSize="12" ToolTip.Tip="Close split view (Ctrl+\)" Click="SplitClose_Click"/>
                </StackPanel>
                <StackPanel x:Name="SplitTitleArea" VerticalAlignment="Center" Margin="8,0" Cursor="Hand" Background="Transparent" ToolTip.Tip="Open this folder in the main pane">
                  <TextBlock x:Name="SplitTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="SplitSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
              <ListBox x:Name="SplitList" Grid.Row="1" Classes="flat rows" Padding="0,2" SelectionMode="Multiple" IsTextSearchEnabled="True">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:FileItem">
                    <DockPanel Opacity="{Binding ItemOpacity}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1200">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0"/>
                      <Image DockPanel.Dock="Left" Source="{Binding SmallIcon}" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="SplitEmpty" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
              <Border x:Name="SplitGrip" Grid.RowSpan="2" HorizontalAlignment="Left" Width="8" Margin="-4,0,0,0" Cursor="SizeWestEast" Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Bottom bar -->
          <Grid Grid.Row="4" Margin="12,6,12,10">
            <Border Classes="pill" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Button Classes="icon" Content="&#xE909;" FontSize="14" Click="FindEverywhere_Click" ToolTip.Tip="Search everywhere (Ctrl+K)"/>
                <Button x:Name="SearchBtn" Classes="icon" Content="&#xE721;" FontSize="14" Click="SearchBtn_Click" ToolTip.Tip="Filter this folder (Ctrl+F)"/>
                <TextBox x:Name="SearchBox" Classes="field" Width="220" Height="28" MinHeight="28" Margin="2,0,4,0" IsVisible="False"/>
                <ToggleButton x:Name="HiddenToggle" Classes="icon" Content="&#xE7B3;" FontSize="14" Click="HiddenToggle_Click" ToolTip.Tip="Show hidden items (Ctrl+H)"/>
              </StackPanel>
            </Border>

            <Border Classes="pill" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SelText" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,6,0" IsVisible="False"/>
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,6,0" ToolTip.Tip="Folders"/>
                <TextBlock x:Name="FolderCount" Text="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,6,0" ToolTip.Tip="Files"/>
                <TextBlock x:Name="FileCount" Text="0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                <Button Classes="icon" Content="&#xE8CB;" FontSize="14" Click="Sort_Click" ToolTip.Tip="Sort"/>
                <Button x:Name="ViewBtn" Classes="icon" Content="&#xE8FD;" FontSize="14" Click="ViewToggle_Click" ToolTip.Tip="Switch view"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ===================== QUICK PREVIEW (Space) ===================== -->
        <Grid x:Name="PreviewOverlay" Grid.ColumnSpan="3" IsVisible="False" Background="#B0000000">
          <Border x:Name="PreviewCard" Margin="70,56,70,40" MaxWidth="1180" CornerRadius="14" BorderThickness="1" ClipToBounds="True"
                  Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource LineBrush}" BoxShadow="0 8 40 0 #8C000000">
            <Grid RowDefinitions="Auto,*,Auto">
              <!-- header -->
              <Border Padding="16,12,10,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PvOpenBtn" Classes="dlg" Focusable="False" Content="Open" Click="PvOpen_Click" MinWidth="0" Padding="14,6"/>
                    <Button Classes="icon" Content="&#xE7AC;" ToolTip.Tip="Open with…" Click="PvOpenWith_Click" Margin="6,0,0,0"/>
                    <Button Classes="icon" Content="&#xE711;" FontSize="12" ToolTip.Tip="Close (Space / Esc)" Click="PvClose_Click" Margin="2,0,0,0"/>
                  </StackPanel>
                  <Image x:Name="PvIcon" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PvName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PvMeta" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- content -->
              <Grid x:Name="PvHost" Grid.Row="1" ClipToBounds="True" Background="{DynamicResource SidebarBg}">
                <Image x:Name="PvImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="16" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <TextBox x:Name="PvText" IsVisible="False" IsReadOnly="True" BorderThickness="0" Padding="16,12" Background="Transparent"
                         Foreground="{DynamicResource TextBrush}" SelectionBrush="{DynamicResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="NoWrap"/>

                <Grid x:Name="PvMediaHost" IsVisible="False">
                  <Image x:Name="PvPoster" Stretch="Uniform" Margin="8" IsVisible="False"/>
                  <ContentControl x:Name="PvMedia" Margin="8"/>
                  <TextBlock x:Name="PvAudioGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="90"
                             Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                </Grid>

                <ScrollViewer x:Name="PvPages" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="PvPagesPanel" Margin="24,16"/>
                </ScrollViewer>

                <Grid x:Name="PvList" IsVisible="False" RowDefinitions="Auto,*" Margin="10,6">
                  <Grid ColumnDefinitions="*,110,110" Margin="10,4,24,4">
                    <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"/>
                    <TextBlock Grid.Column="1" Text="Size" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="PvListExtraCol" Grid.Column="2" Text="Packed" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Right"/>
                  </Grid>
                  <ListBox x:Name="PvListBox" Grid.Row="1" Classes="flat plain" Focusable="False">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="local:ListRow">
                        <Grid ColumnDefinitions="*,110,110" Margin="4,3">
                          <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                          <TextBlock Grid.Column="2" Text="{Binding Extra}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <StackPanel x:Name="PvInfo" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                  <Image x:Name="PvInfoImage" Width="256" Height="256" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <TextBlock x:Name="PvInfoText" Margin="0,18,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <TextBlock x:Name="PvLoading" Text="Loading preview…" Foreground="{DynamicResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
              </Grid>

              <!-- footer -->
              <Border Grid.Row="2" Padding="16,9" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                  <StackPanel x:Name="PvMediaBar" DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="False" Margin="0,0,16,0">
                    <Button x:Name="PvPlayBtn" Classes="icon" Content="&#xE769;" Click="PvPlay_Click" ToolTip.Tip="Play / pause"/>
                    <Slider x:Name="PvSeek" Width="320" VerticalAlignment="Center" Margin="8,0" Minimum="0" Maximum="1" IsSnapToTickEnabled="False"/>
                    <TextBlock x:Name="PvTime" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                  </StackPanel>
                  <TextBlock x:Name="PvHint" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                             Text="Space or Esc to close  ·  arrow keys for next / previous"/>
                  <TextBlock x:Name="PvNote" VerticalAlignment="Center" Foreground="{DynamicResource SectionBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ===================== FIND ANYTHING (Ctrl+K) ===================== -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="3" IsVisible="False" Background="#99000000">
          <Border x:Name="SearchCard" Width="820" Margin="0,70,0,60" VerticalAlignment="Top" CornerRadius="16" BorderThickness="1"
                  Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource LineBrush}" BoxShadow="0 8 40 0 #8C000000">
            <StackPanel>
              <Grid Margin="20,14,20,10" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="FindBox" Grid.Column="1" Classes="find" FontSize="20" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                         Watermark="Search every file and folder…" VerticalContentAlignment="Center" Padding="2,4"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock x:Name="FindTime" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="12,0"/>
                  <TextBlock x:Name="FindCount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <Border Background="{DynamicResource PanelBg}" CornerRadius="9" Padding="2" HorizontalAlignment="Left" Margin="18,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="FindAll" Classes="seg" Content="All" GroupName="findkind" IsChecked="True" Click="FindKind_Click" Focusable="False"/>
                  <RadioButton x:Name="FindFolders" Classes="seg" Content="Folders" GroupName="findkind" Click="FindKind_Click" Focusable="False"/>
                  <RadioButton x:Name="FindFiles" Classes="seg" Content="Files" GroupName="findkind" Click="FindKind_Click" Focusable="False"/>
                </StackPanel>
              </Border>

              <Border Height="1" Background="{DynamicResource LineBrush}"/>

              <Grid>
                <ListBox x:Name="FindResults" Classes="flat results" MaxHeight="460" Padding="8,6" Focusable="False" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SearchHit">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,14,0" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <local:HighlightTextBlock Grid.Column="1" Segments="{Binding Segments}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Where}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="330" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FindEmpty" Margin="24,22" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="False"/>
              </Grid>

              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9">
                <DockPanel>
                  <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                  <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Text="↑↓ choose  ·  Enter open  ·  Ctrl+Enter show in folder  ·  Esc close"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- resize grips (Orbit draws its own window frame, as on Windows) -->
    <Panel x:Name="Grips">
      <Border Tag="N" Height="5" VerticalAlignment="Top" Margin="8,0" Background="Transparent" Cursor="TopSide"/>
      <Border Tag="S" Height="5" VerticalAlignment="Bottom" Margin="8,0" Background="Transparent" Cursor="BottomSide"/>
      <Border Tag="W" Width="5" HorizontalAlignment="Left" Margin="0,8" Background="Transparent" Cursor="LeftSide"/>
      <Border Tag="E" Width="5" HorizontalAlignment="Right" Margin="0,8" Background="Transparent" Cursor="RightSide"/>
      <Border Tag="NW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner"/>
      <Border Tag="NE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner"/>
      <Border Tag="SW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner"/>
      <Border Tag="SE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner"/>
    </Panel>
  </Panel>

  <Window.Styles>
    <Style Selector="Border.tab TextBlock.tabText"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Border.tab.active TextBlock.tabText"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Border.tab Button.tabClose"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Border.tab:pointerover Button.tabClose"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Border.tab.active Button.tabClose"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Border.tab:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Border.tab Border.underline"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Border.tab.active Border.underline"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Border.dz Button.dzx"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Border.dz:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Style>
    <Style Selector="Border.dz:pointerover Button.dzx"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="TextBox.find /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox.find:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox.find:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox.find:focus"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBox.find /template/ TextBlock#PART_Watermark"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></Style>
  </Window.Styles>
</Window>
